{
  "name": "super-microbe-world",
  "private": true,
  "description": "Browser-native remake of Super Microbe World (e-Bug Junior Game). The game in web/ has no runtime dependencies; these are dev-only tools.",
  "type": "module",
  "scripts": {
    "serve": "npx --yes serve web",
    "test": "node web/tests/run.mjs",
    "art:sheets": "node tools/swf-sheet/sheet.mjs tools/swf-sheet/jobs/level1.json",
    "art:atlas": "node tools/build-atlas.cjs tools/atlas/level1.json",
    "art:verify": "node tools/swf-sheet/verify-atlas.mjs",
    "test:unit": "node --test web/tests/unit/*.test.mjs",
    "levels": "node tools/convert-levels.mjs && node tools/extract-timelines.mjs",
    "test:platform": "node web/tests/run.mjs --no-unit level1",
    "screenshots": "node web/tests/run.mjs --no-unit --screenshots level1"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@ruffle-rs/ruffle": "^0.6.0",
    "swf-parser": "^0.14.1"
  }
}
